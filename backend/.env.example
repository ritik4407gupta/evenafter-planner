APP_NAME=EverAfter
ENVIRONMENT=development
DATABASE_URL=sqlite:///./everafter.db
JWT_SECRET=replace-this-with-a-long-random-secret-before-deploying
JWT_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:5173
# API keys are entered per account in Settings and stored encrypted in the database.
# Set a distinct Fernet key for production; generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_KEYS_ENCRYPTION_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
